<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>Tpei的贪吃蛇</title>
<HTA:APPLICATION ID="snake" SCROLL="no" SINGLEINSTANCE="yes" WINDOWSTATE="normal" />
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    background: #1a1d24; color: #e8e6e1;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    text-align: center; padding: 30px 16px 50px;
  }
  h1 { font-size: 22px; letter-spacing: 0; font-weight: 600; color: #7ec8a9; margin-bottom: 14px; }
  .hud { display: inline-block; margin-bottom: 14px; font-size: 14px; color: #9aa0a6; }
  .hud span { margin: 0 14px; }
  .hud b { color: #e8e6e1; font-size: 18px; margin-left: 6px; }
  #wrap { position: relative; display: inline-block; }
  canvas {
    background: #23262e; border: 2px solid #3a3f4b; border-radius: 8px;
    display: block; max-width: 100%;
  }
  #overlay {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0; border-radius: 8px;
    background: rgba(20,22,28,.82); display: table; width: 100%; text-align: center;
  }
  #overlay.hidden { display: none; }
  .ov-inner { display: table-cell; vertical-align: middle; }
  #overlay .title { font-size: 20px; font-weight: 600; margin-bottom: 12px; }
  #overlay .sub { font-size: 13px; color: #9aa0a6; line-height: 1.9; }
  #overlay button, #btn-dl {
    margin-top: 14px; padding: 10px 32px; font-size: 15px; letter-spacing: 2px;
    background: #7ec8a9; color: #1a1d24; border: none; border-radius: 6px;
    cursor: pointer; font-weight: 600; font-family: "Microsoft YaHei", sans-serif;
  }
  #overlay button:hover { background: #93d6ba; }
  .tips { font-size: 12px; color: #6b7078; letter-spacing: 1px; margin: 16px 0 10px; }
  #btn-dl { background: transparent; color: #7ec8a9; border: 1px solid #3f6b58;
    padding: 8px 24px; font-size: 13px; font-weight: normal; }
</style>
</head>
<body bgcolor="#1a1d24">
  <h1>Tpei的贪吃蛇</h1>
  <div class="hud">
    <span>得分<b id="score">0</b></span>
    <span>最高<b id="best">0</b></span>
  </div>
  <div id="wrap">
    <canvas id="cv" width="400" height="400"></canvas>
    <div id="overlay">
      <div class="ov-inner">
        <div class="title" id="ov-title">准备开始</div>
        <div class="sub" id="ov-sub">方向键 / WASD 控制移动<br>空格键暂停</div>
        <button id="btn-start">开始游戏</button>
      </div>
    </div>
  </div>
  <div class="tips">↑ ↓ ← → / W A S D 移动 · 空格 暂停 · 单文件游戏，可直接分享</div>
  <button id="btn-dl">下载游戏（发给朋友即可玩）</button>

<script>
// 全局错误兜底
window.onerror = function (msg) {
  var t = document.getElementById('ov-title'), s = document.getElementById('ov-sub');
  if (t && s) { t.innerHTML = '出错了'; s.innerHTML = String(msg); }
};
(function () {
  'use strict';

  var GRID = 20, CELL = 400 / GRID;
  var cv = document.getElementById('cv'), ctx = cv.getContext('2d');
  var elScore = document.getElementById('score'), elBest = document.getElementById('best');
  var overlay = document.getElementById('overlay');
  var ovTitle = document.getElementById('ov-title'), ovSub = document.getElementById('ov-sub');
  var btnStart = document.getElementById('btn-start');
  var btnDl = document.getElementById('btn-dl');

  var snake, dir, dirQueue, food, score, speed, timer, state;
  // localStorage 安全封装（受限环境可能抛错）
  var store = {
    get: function (k) { try { return window.localStorage.getItem(k); } catch (e) { return null; } },
    set: function (k, v) { try { window.localStorage.setItem(k, v); } catch (e) {} }
  };
  var best = +(store.get('snake_best') || 0);
  elBest.innerHTML = best;

  // 分享下载：IE 不支持 a[download]，给提示
  var isOldIE = /MSIE \d|Trident\/.*rv:11/.test(navigator.userAgent);
  if (isOldIE) {
    btnDl.innerHTML = '当前浏览器不支持下载，直接复制本文件分享即可';
  } else {
    var SOURCE_HTML = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
    btnDl.onclick = function () {
      var blob = new Blob([SOURCE_HTML], { type: 'text/html;charset=utf-8' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'tpei的贪吃蛇.html';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
    };
  }

  function reset() {
    snake = [{x: 9, y: 10}, {x: 8, y: 10}, {x: 7, y: 10}];
    dir = {x: 1, y: 0}; dirQueue = [];
    score = 0; speed = 150; state = 'running';
    elScore.innerHTML = '0';
    placeFood();
    overlay.className = 'hidden';
    clearInterval(timer);
    timer = setInterval(tick, speed);
    draw();
  }

  function placeFood() {
    var ok = false;
    while (!ok) {
      food = { x: Math.floor(Math.random() * GRID), y: Math.floor(Math.random() * GRID) };
      ok = true;
      for (var i = 0; i < snake.length; i++) {
        if (snake[i].x === food.x && snake[i].y === food.y) { ok = false; break; }
      }
    }
  }

  function tick() {
    if (dirQueue.length) {
      var nd = dirQueue.shift();
      if (nd.x !== -dir.x || nd.y !== -dir.y) dir = nd; // 防止 180 度回头
    }
    var head = { x: snake[0].x + dir.x, y: snake[0].y + dir.y };

    var hitWall = head.x < 0 || head.x >= GRID || head.y < 0 || head.y >= GRID;
    var hitSelf = false;
    for (var i = 0; i < snake.length - 1; i++) {
      if (snake[i].x === head.x && snake[i].y === head.y) { hitSelf = true; break; }
    }
    if (hitWall || hitSelf) return gameOver();

    snake.unshift(head);
    if (head.x === food.x && head.y === food.y) {
      score += 10;
      elScore.innerHTML = String(score);
      placeFood();
      if (score % 30 === 0 && speed > 70) { // 每吃 3 个加速
        speed -= 10;
        clearInterval(timer);
        timer = setInterval(tick, speed);
      }
    } else {
      snake.pop();
    }
    draw();
  }

  function gameOver() {
    state = 'over';
    clearInterval(timer);
    if (score > best) {
      best = score;
      store.set('snake_best', best);
      elBest.innerHTML = best;
    }
    ovTitle.innerHTML = '游戏结束';
    var rec = (score >= best && score > 0) ? ' 🎉 新纪录！' : '';
    ovSub.innerHTML = '本局得分 <b style="color:#e8e6e1">' + score + '</b>' + rec +
      '<br>最高纪录 ' + best;
    btnStart.innerHTML = '再来一局';
    overlay.className = '';
  }

  function rr(x, y, w, h, r) {
    // 圆角矩形路径（IE 无 roundRect，手绘）
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.lineTo(x + w - r, y); ctx.quadraticCurveTo(x + w, y, x + w, y + r);
    ctx.lineTo(x + w, y + h - r); ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    ctx.lineTo(x + r, y + h); ctx.quadraticCurveTo(x, y + h, x, y + h - r);
    ctx.lineTo(x, y + r); ctx.quadraticCurveTo(x, y, x + r, y);
    ctx.closePath();
  }

  function draw() {
    ctx.clearRect(0, 0, 400, 400);
    ctx.strokeStyle = 'rgba(255,255,255,.03)';
    for (var i = 1; i < GRID; i++) {
      ctx.beginPath(); ctx.moveTo(i * CELL, 0); ctx.lineTo(i * CELL, 400); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(0, i * CELL); ctx.lineTo(400, i * CELL); ctx.stroke();
    }
    ctx.fillStyle = '#e06c5a';
    ctx.beginPath();
    ctx.arc(food.x * CELL + CELL / 2, food.y * CELL + CELL / 2, CELL / 2 - 3, 0, Math.PI * 2);
    ctx.fill();
    for (var j = 0; j < snake.length; j++) {
      var s = snake[j], t = j / snake.length;
      ctx.fillStyle = j === 0 ? '#8fe3bd' : 'rgba(126,200,169,' + (1 - t * 0.55) + ')';
      rr(s.x * CELL + 1, s.y * CELL + 1, CELL - 2, CELL - 2, 4);
      ctx.fill();
    }
    var h = snake[0];
    ctx.fillStyle = '#1a1d24';
    var cx = h.x * CELL + CELL / 2, cy = h.y * CELL + CELL / 2;
    var ex = dir.y !== 0 ? 4 : 2, ey = dir.x !== 0 ? 4 : 2;
    ctx.beginPath(); ctx.arc(cx + dir.x * 4 + ex, cy + dir.y * 4 + ey, 1.8, 0, Math.PI * 2); ctx.fill();
    ctx.beginPath(); ctx.arc(cx + dir.x * 4 - ex, cy + dir.y * 4 - ey, 1.8, 0, Math.PI * 2); ctx.fill();
  }

  function turn(x, y) {
    if (state === 'running') dirQueue.push({ x: x, y: y });
  }

  // 用 keyCode（IE 不支持 e.key；keyCode 各浏览器通用）
  document.onkeydown = function (e) {
    e = e || window.event;
    var k = e.keyCode;
    if (k === 38 || k === 40 || k === 37 || k === 39 || k === 32 ||
        k === 87 || k === 83 || k === 65 || k === 68) {
      if (e.preventDefault) e.preventDefault(); else e.returnValue = false;
    }
    if (k === 38 || k === 87) turn(0, -1);
    else if (k === 40 || k === 83) turn(0, 1);
    else if (k === 37 || k === 65) turn(-1, 0);
    else if (k === 39 || k === 68) turn(1, 0);
    else if (k === 32 && (state === 'running' || state === 'paused')) {
      if (state === 'running') {
        state = 'paused'; clearInterval(timer);
        ovTitle.innerHTML = '已暂停'; ovSub.innerHTML = '按空格或点击按钮继续';
        btnStart.innerHTML = '继续';
        overlay.className = '';
      } else {
        state = 'running'; overlay.className = 'hidden';
        timer = setInterval(tick, speed);
      }
    }
  };

  btnStart.onclick = function () {
    if (state === 'paused') {
      state = 'running'; overlay.className = 'hidden';
      timer = setInterval(tick, speed);
    } else {
      reset();
    }
  };

  // 初始画面
  snake = [{x: 9, y: 10}, {x: 8, y: 10}, {x: 7, y: 10}];
  dir = {x: 1, y: 0}; food = {x: 14, y: 10}; state = 'idle';
  draw();
})();
</script>
</body>
</html>

<script>
try { window.resizeTo(480, 660); window.moveTo((screen.width-480)/2, (screen.height-680)/2); } catch(e) {}
</script>
